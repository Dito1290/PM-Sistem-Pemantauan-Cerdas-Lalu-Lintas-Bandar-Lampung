# Copy to backend/.env and fill in. Never commit backend/.env.
APP_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

DATABASE_URL=postgresql+psycopg://citysight:CHANGE_ME@127.0.0.1:5432/citysight
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL defaults to REDIS_URL

# Comma-separated list of dashboard origins (no "*")
FRONTEND_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (for real client IPs); 0 = none
TRUSTED_PROXY_COUNT=0

# --- Video pipeline (proposal values) ---
MAX_ACTIVE_CAMERAS=3
FRAME_INTERVAL_SECONDS=0.2
FRAME_QUEUE_MAX=10
FRAME_MAX_AGE_SECONDS=5
JPEG_QUALITY=80
STREAM_RECONNECT_DELAY_SECONDS=5
STREAM_OPEN_TIMEOUT_MS=10000
STREAM_READ_TIMEOUT_MS=10000
CAMERA_SYNC_INTERVAL_SECONDS=10
STREAM_ALLOWED_SCHEMES=rtsp,rtsps,http,https
# Optional: restrict stream hosts, e.g. the Seribu Wajah stream host once known
STREAM_ALLOWED_HOSTS=
# true only for testing with local backup videos (absolute paths on the server)
ALLOW_FILE_SOURCES=false

# --- YOLO ---
YOLO_MODEL_PATH=models/yolo.pt
YOLO_CONFIDENCE=0.70
YOLO_IOU=0.50
YOLO_AGNOSTIC_NMS=true
YOLO_IMGSZ=640
# cpu, 0 (first CUDA GPU), mps ... ; empty = Ultralytics default
YOLO_DEVICE=
YOLO_CLASS_NAMES={"car": "car", "motorcycle": "motorcycle", "bus": "bus", "truck": "truck"}

# --- Statistics ---
REPORT_TIMEZONE=Asia/Jakarta
HOURLY_AGGREGATION_MINUTE=5
HOURLY_AGGREGATION_LOOKBACK_HOURS=2

# --- Logging ---
LOG_LEVEL=INFO
# Directory for daily-rotated log files; empty = console only
LOG_DIR=

# --- Tests only ---
# TEST_DATABASE_URL=postgresql+psycopg://citysight@127.0.0.1:5432/citysight_test
# TEST_REDIS_URL=redis://127.0.0.1:6379/15
